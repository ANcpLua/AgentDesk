<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <WarningsAsErrors>$(WarningsAsErrors);CS8509;CS8655;CS8846</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14"/>
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="AgentDesk.Tests" />
    </ItemGroup>
</Project>
